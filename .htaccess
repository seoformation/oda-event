# Sécurité de base — OrTra Suisse de l'Événementiel

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Certaines configurations Apache/PHP-FPM ne transmettent pas l'en-tête
# Authorization à PHP par défaut : nécessaire pour statut-webhook.php
# (appelé par event-swiss.com avec "Authorization: Bearer ...").
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Bloque l'accès direct aux fichiers PHP sensibles (identifiants, fonctions internes)
<FilesMatch "^(config|functions|db|i18n)\.php$">
  Require all denied
</FilesMatch>

# Bloque l'accès aux journaux d'erreurs PHP (peuvent apparaître si aucun
# chemin de log n'est explicitement configuré côté serveur)
<FilesMatch "^error_log$">
  Require all denied
</FilesMatch>

# Empêche l'affichage du contenu des dossiers
Options -Indexes

# En-têtes de sécurité HTTP
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
